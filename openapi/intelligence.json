{
  "openapi": "3.1.0",
  "info": {
    "title": "Malvo — Inteligência & Enriquecimento",
    "version": "1.0.0",
    "description": "APIs de Inteligência e Enriquecimento da Malvo, servidas no host único `https://api.malvo.io` e com contrato wire estável. Autenticação por header `X-API-KEY` em todas as operações. Estas APIs entregam KPIs agregados por item (Item Insights), enriquecimento/categorização de transações próprias do cliente (Enrich) e detecção de pagamentos recorrentes (assinaturas, salários, contas). Não há iniciação de pagamento (sem ITP). Prosa em pt-BR; nomes de campos e enums em inglês, conforme a especificação."
  },
  "servers": [
    { "url": "https://api.malvo.io" }
  ],
  "security": [
    { "apiKeyAuth": [] }
  ],
  "tags": [
    {
      "name": "Insights",
      "description": "KPIs agregados e pré-computados por item e por classe de conta (subscrição de crédito, segmentação)."
    },
    {
      "name": "Enrich",
      "description": "Enriquecimento de transações: categorização/identificação de merchant e detecção de pagamentos recorrentes."
    }
  ],
  "paths": {
