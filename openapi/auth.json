{
  "openapi": "3.1.0",
  "info": {
    "title": "Malvo — Autenticação & Conectores",
    "version": "1.0.0",
    "description": "API da Malvo para autenticação por credenciais de cliente, emissão de tokens do Connect Widget, consulta de conectores e consentimentos de Open Finance. Contrato público estável, sem iniciação de pagamentos."
  },
  "servers": [
    { "url": "https://api.malvo.io" }
  ],
  "security": [
    { "apiKeyAuth": [] }
  ],
  "tags": [
    { "name": "Auth", "description": "Troca de credenciais de cliente por apiKey e emissão de tokens do Connect Widget." },
    { "name": "Connectors", "description": "Listagem e consulta de instituições financeiras integradas (conectores)." },
    { "name": "Consents", "description": "Consulta dos consentimentos de Open Finance vinculados aos items." }
  ],
  "paths": {
    "/auth": {
      "post": {
        "tags": ["Auth"],
        "operationId": "createApiKey",
        "summary": "Troca credenciais de cliente por uma apiKey",
        "description": "Recebe `clientId` e `clientSecret` (emitidos no Dashboard, uso server-side apenas) e devolve uma `apiKey` com TTL de 2 horas. A apiKey é enviada no header `X-API-KEY` nas demais chamadas server-side. Esta operação NÃO exige header de autenticação.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthRequest" },
              "example": {
                "clientId": "b6e3a4c2-1234-4d5e-9f00-abcdefabcdef",
                "clientSecret": "<CLIENT_SECRET>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "apiKey emitida com sucesso (TTL de 2 horas).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" },
                "example": {
                  "apiKey": "<API_KEY>"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas (`CLIENT_KEYS_UNAUTHORIZED`) ou Application desabilitada (`CLIENT_DISABLED`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "examples": {
                  "clientKeysUnauthorized": {
                    "summary": "clientId/clientSecret incorretos",
                    "value": {
                      "code": 401,
                      "message": "Client keys are invalid",
                      "codeDescription": "CLIENT_KEYS_UNAUTHORIZED"
                    }
                  },
                  "clientDisabled": {
                    "summary": "Application desabilitada no Dashboard",
                    "value": {
                      "code": 401,
                      "message": "Client is disabled",
                      "codeDescription": "CLIENT_DISABLED"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Falha interna do servidor — repetir com backoff.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "example": {
                  "code": 500,
                  "message": "Internal server error",
                  "codeDescription": "INTERNAL_SERVER_ERROR"
                }
              }
            }
          }
        }
      }
    },
    "/connect_token": {
      "post": {
        "tags": ["Auth"],
        "operationId": "createConnectToken",
        "summary": "Emite um token com escopo do Connect Widget",
        "description": "Gera um `accessToken` de 30 minutos para dirigir o Connect Widget. Todos os campos são opcionais — um corpo `{}` retorna um token para criar um novo item. Passe `itemId` apenas para colocar o widget em modo de atualização de um item existente. ATENÇÃO: falha de autenticação aqui retorna 403 (não 401) — trate como \"renove a apiKey via POST /auth e tente novamente\".",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConnectTokenRequest" },
              "example": {
                "itemId": "a8f4f3e1-7b2c-4d4e-8f9a-0b1c2d3e4f5a",
                "options": {
                  "clientUserId": "my-user-42",
                  "webhookUrl": "https://your.app/webhooks/malvo",
                  "oauthRedirectUri": "https://your.app/oauth/callback",
                  "avoidDuplicates": true,
                  "products": ["ACCOUNTS", "TRANSACTIONS"]
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Token do widget emitido com sucesso (TTL de 30 minutos).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConnectTokenResponse" },
                "example": {
                  "accessToken": "<CONNECT_TOKEN>"
                }
              }
            }
          },
          "402": {
            "description": "Saldo de créditos pré-pagos zerado (`CREDITS_EXHAUSTED`). Novas conexões ficam pausadas até a recarga; os dados existentes continuam acessíveis. Ativo para contas novas desde 04/10/2026 e para as existentes a partir de 01/12/2026 — veja [Créditos pré-pagos](/dashboard/credits).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlobalErrorResponse"
                },
                "example": {
                  "code": 402,
                  "message": "Prepaid credits exhausted",
                  "codeDescription": "CREDITS_EXHAUSTED"
                }
              }
            }
          },
          "403": {
            "description": "Header `X-API-KEY` ausente, malformado ou expirado. Diferente das demais rotas, aqui a falha de autenticação surge como 403, não 401.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "example": {
                  "code": 403,
                  "message": "Missing or invalid authorization token"
                }
              }
            }
          },
          "404": {
            "description": "O `itemId` informado para atualização não existe ou foi removido.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "example": {
                  "code": 404,
                  "message": "Item not found",
                  "codeDescription": "ITEM_NOT_FOUND"
                }
              }
            }
          },
          "500": {
            "description": "Falha interna do servidor — repetir com backoff.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "example": {
                  "code": 500,
                  "message": "Internal server error",
                  "codeDescription": "INTERNAL_SERVER_ERROR"
                }
              }
            }
          }
        }
      }
    },
    "/connectors": {
      "get": {
        "tags": ["Connectors"],
        "operationId": "listConnectors",
        "summary": "Lista os conectores disponíveis",
        "description": "Retorna o envelope paginado de conectores acessíveis à Application autenticada. O catálogo real é dinâmico: Open Finance Brasil e instituições AIS internacionais nas jurisdições habilitadas. Trate ids como opacos e use `isOpenFinance=true`, `countries`, `types` e `products` para filtrar.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "Busca parcial e case-insensitive no `name` do conector.",
            "schema": { "type": "string" },
            "example": "Nubank"
          },
          {
            "name": "countries",
            "in": "query",
            "required": false,
            "description": "Filtra por país ISO-3166-1 alpha-2. Aceita lista separada por vírgula, ex.: `BR` ou `FI,SE,GB`.",
            "schema": { "type": "string" },
            "example": "FI,SE,GB"
          },
          {
            "name": "types",
            "in": "query",
            "required": false,
            "description": "Filtra por `type` do conector. Aceita lista separada por vírgula do enum de tipos.",
            "schema": { "type": "string" },
            "example": "PERSONAL_BANK"
          },
          {
            "name": "sandbox",
            "in": "query",
            "required": false,
            "description": "Em aplicação de produção, `true` inclui conectores sandbox. Aplicações SANDBOX enxergam somente conectores `isSandbox: true`.",
            "schema": { "type": "boolean", "default": false },
            "example": false
          },
          {
            "name": "isOpenFinance",
            "in": "query",
            "required": false,
            "description": "`true` retorna conectores regulados de Open Finance/Open Banking; não infira esse valor pela faixa do id.",
            "schema": { "type": "boolean" },
            "example": true
          },
          {
            "name": "products",
            "in": "query",
            "required": false,
            "description": "Retorna apenas conectores que suportam TODOS os produtos listados. Lista separada por vírgula do enum de produtos.",
            "schema": { "type": "string" },
            "example": "ACCOUNTS,TRANSACTIONS"
          },
          {
            "name": "supportsPaymentInitiation",
            "in": "query",
            "required": false,
            "description": "Aceito por compatibilidade de wire. Na Malvo, `true` sempre resulta em conjunto vazio (sem iniciação de pagamentos).",
            "schema": { "type": "boolean" },
            "example": false
          }
        ],
        "responses": {
          "200": {
            "description": "Envelope paginado de conectores.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConnectorsPage" },
                "example": {
                  "total": 1,
                  "totalPages": 1,
                  "page": 1,
                  "results": [
                    {
                      "id": 612,
                      "name": "Nubank",
                      "institutionUrl": "https://nubank.com.br",
                      "imageUrl": "https://malvo.io/connectors/nubank.svg",
                      "primaryColor": "820AD1",
                      "country": "BR",
                      "type": "PERSONAL_BANK",
                      "credentials": [
                        {
                          "label": "CPF",
                          "name": "cpf",
                          "type": "number",
                          "placeholder": "999.999.999-99",
                          "validation": "^\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}$",
                          "validationMessage": "CPF deve ter 11 dígitos",
                          "optional": false
                        }
                      ],
                      "products": ["ACCOUNTS", "CREDIT_CARDS", "TRANSACTIONS", "INVESTMENTS", "IDENTITY"],
                      "isOpenFinance": true,
                      "isSandbox": false,
                      "oauth": true,
                      "oauthUrl": null,
                      "hasMFA": false,
                      "supportsPaymentInitiation": false,
                      "health": { "status": "ONLINE", "stage": null },
                      "createdAt": "2024-06-01T00:00:00.000Z",
                      "updatedAt": "2025-01-01T00:00:00.000Z"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "`X-API-KEY` ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "example": {
                  "code": 401,
                  "message": "Missing or invalid authorization token",
                  "codeDescription": "CLIENT_KEYS_UNAUTHORIZED"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições por IP/minuto excedido.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "example": {
                  "code": 429,
                  "message": "Too many requests. Please try again later (see Retry-After header in seconds)",
                  "codeDescription": "TOO_MANY_REQUESTS"
                }
              }
            }
          },
          "500": {
            "description": "Falha interna do servidor — repetir com backoff.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "example": {
                  "code": 500,
                  "message": "Internal server error",
                  "codeDescription": "INTERNAL_SERVER_ERROR"
                }
              }
            }
          }
        }
      }
    },
    "/connectors/{id}": {
      "get": {
        "tags": ["Connectors"],
        "operationId": "getConnector",
        "summary": "Consulta um conector pelo id",
        "description": "Retorna um único conector pelo seu id inteiro. Conectores sandbox não são visíveis sem o opt-in de sandbox.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id inteiro do conector.",
            "schema": { "type": "integer" },
            "example": 612
          }
        ],
        "responses": {
          "200": {
            "description": "Conector encontrado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Connector" },
                "example": {
                  "id": 612,
                  "name": "Nubank",
                  "institutionUrl": "https://nubank.com.br",
                  "imageUrl": "https://malvo.io/connectors/nubank.svg",
                  "primaryColor": "820AD1",
                  "country": "BR",
                  "type": "PERSONAL_BANK",
                  "credentials": [
                    {
                      "label": "CPF",
                      "name": "cpf",
                      "type": "number",
                      "placeholder": "999.999.999-99",
                      "validation": "^\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}$",
                      "validationMessage": "CPF deve ter 11 dígitos",
                      "optional": false
                    }
                  ],
                  "products": ["ACCOUNTS", "CREDIT_CARDS", "TRANSACTIONS", "INVESTMENTS", "IDENTITY"],
                  "isOpenFinance": true,
                  "isSandbox": false,
                  "oauth": true,
                  "oauthUrl": null,
                  "hasMFA": false,
                  "supportsPaymentInitiation": false,
                  "health": { "status": "ONLINE", "stage": null },
                  "createdAt": "2024-06-01T00:00:00.000Z",
                  "updatedAt": "2025-01-01T00:00:00.000Z"
                }
              }
            }
          },
          "401": {
            "description": "`X-API-KEY` ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "example": {
                  "code": 401,
                  "message": "Missing or invalid authorization token",
                  "codeDescription": "CLIENT_KEYS_UNAUTHORIZED"
                }
              }
            }
          },
          "404": {
            "description": "Conector desconhecido ou visível apenas em sandbox.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "example": {
                  "code": 404,
                  "message": "Connector not found"
                }
              }
            }
          }
        }
      }
    },
    "/consents": {
      "get": {
        "tags": ["Consents"],
        "operationId": "listConsents",
        "summary": "Lista consentimentos de um item",
        "description": "Retorna o envelope paginado de consentimentos vinculados ao `itemId` informado.",
        "parameters": [
          {
            "name": "itemId",
            "in": "query",
            "required": true,
            "description": "Id (UUID) do item dono dos consentimentos. Obrigatório.",
            "schema": { "type": "string", "format": "uuid" },
            "example": "a8f4f3e1-7b2c-4d4e-8f9a-0b1c2d3e4f5a"
          }
        ],
        "responses": {
          "200": {
            "description": "Envelope paginado de consentimentos.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConsentsPage" },
                "example": {
                  "total": 1,
                  "totalPages": 1,
                  "page": 1,
                  "results": [
                    {
                      "id": "c1d2e3f4-0000-4abc-9def-111213141516",
                      "itemId": "a8f4f3e1-7b2c-4d4e-8f9a-0b1c2d3e4f5a",
                      "status": "AUTHORISED",
                      "products": ["ACCOUNTS", "TRANSACTIONS"],
                      "openFinancePermissionsGranted": ["ACCOUNTS", "BALANCES", "TRANSACTIONS"],
                      "createdAt": "2025-01-01T00:00:00.000Z",
                      "updatedAt": "2025-01-01T00:05:00.000Z",
                      "expiresAt": "2025-06-30T00:00:00.000Z",
                      "revokedAt": null
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "`X-API-KEY` ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "example": {
                  "code": 401,
                  "message": "Missing or invalid authorization token",
                  "codeDescription": "CLIENT_KEYS_UNAUTHORIZED"
                }
              }
            }
          },
          "500": {
            "description": "Falha interna do servidor — repetir com backoff.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "example": {
                  "code": 500,
                  "message": "Internal server error",
                  "codeDescription": "INTERNAL_SERVER_ERROR"
                }
              }
            }
          }
        }
      }
    },
    "/consents/{id}": {
      "get": {
        "tags": ["Consents"],
        "operationId": "getConsent",
        "summary": "Consulta um consentimento pelo id",
        "description": "Retorna um único consentimento pelo seu id (UUID).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id (UUID) do consentimento.",
            "schema": { "type": "string", "format": "uuid" },
            "example": "c1d2e3f4-0000-4abc-9def-111213141516"
          }
        ],
        "responses": {
          "200": {
            "description": "Consentimento encontrado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Consent" },
                "example": {
                  "id": "c1d2e3f4-0000-4abc-9def-111213141516",
                  "itemId": "a8f4f3e1-7b2c-4d4e-8f9a-0b1c2d3e4f5a",
                  "status": "AUTHORISED",
                  "products": ["ACCOUNTS", "TRANSACTIONS", "INVESTMENTS"],
                  "openFinancePermissionsGranted": ["ACCOUNTS_READ", "ACCOUNTS_BALANCES_READ", "RESOURCES_READ"],
                  "createdAt": "2025-01-01T00:00:00.000Z",
                  "updatedAt": "2025-01-01T00:05:00.000Z",
                  "expiresAt": null,
                  "revokedAt": null
                }
              }
            }
          },
          "401": {
            "description": "`X-API-KEY` ausente, inválido ou expirado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "example": {
                  "code": 401,
                  "message": "Missing or invalid authorization token",
                  "codeDescription": "CLIENT_KEYS_UNAUTHORIZED"
                }
              }
            }
          },
          "404": {
            "description": "Consentimento desconhecido.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GlobalErrorResponse" },
                "example": {
                  "code": 404,
                  "message": "Consent not found"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY"
      }
    },
    "schemas": {
      "Product": {
        "type": "string",
        "description": "Produto de dados coletável. Valores exatos e case-sensitive.",
        "enum": [
          "ACCOUNTS",
          "TRANSACTIONS",
          "CREDIT_CARDS",
          "INVESTMENTS",
          "INVESTMENTS_TRANSACTIONS",
          "LOANS",
          "IDENTITY",
          "OPPORTUNITIES",
          "PORTFOLIO",
          "INCOME_REPORTS"
        ],
        "example": "ACCOUNTS"
      },
      "AuthRequest": {
        "type": "object",
        "description": "Credenciais de cliente trocadas por uma apiKey.",
        "required": ["clientId", "clientSecret"],
        "properties": {
          "clientId": {
            "type": "string",
            "format": "uuid",
            "description": "Emitido no Dashboard por Application.",
            "example": "b6e3a4c2-1234-4d5e-9f00-abcdefabcdef"
          },
          "clientSecret": {
            "type": "string",
            "description": "Segredo opaco emitido junto ao clientId; uso server-side apenas.",
            "example": "<CLIENT_SECRET>"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "description": "apiKey emitida pelo endpoint de autenticação.",
        "required": ["apiKey"],
        "properties": {
          "apiKey": {
            "type": "string",
            "description": "String opaca tipo JWT com TTL de 2 horas. Enviada como header `X-API-KEY` nas chamadas server-side.",
            "example": "<API_KEY>"
          }
        }
      },
      "ConnectTokenOptions": {
        "type": "object",
        "description": "Opções de conexão por token, todas opcionais.",
        "properties": {
          "clientUserId": {
            "type": "string",
            "description": "Identificador estável do usuário do integrador. Estampado no Item e recomendado no fluxo internacional para correlação/avoidDuplicates.",
            "example": "my-user-42"
          },
          "webhookUrl": {
            "type": "string",
            "format": "uri",
            "description": "Destino de webhook específico desta conexão (item/created, item/updated, item/error, ...).",
            "example": "https://your.app/webhooks/malvo"
          },
          "oauthRedirectUri": {
            "type": "string",
            "format": "uri",
            "description": "Destino final após o callback Malvo. Deve ser HTTPS absoluto ou deep link seguro; recebe itemId/status/message. Em fluxos por Connect Token, a Malvo também acrescenta o parâmetro reservado malvoFlowId; os SDKs mobile o usam para correlação automática.",
            "example": "https://your.app/oauth/callback"
          },
          "avoidDuplicates": {
            "type": "boolean",
            "description": "Se `true`, reutiliza uma conexão existente; no fluxo internacional usa clientUserId quando ainda não há documento.",
            "example": true
          },
          "products": {
            "type": "array",
            "description": "Subconjunto de connector.products. Conectores internacionais anunciam ACCOUNTS e TRANSACTIONS.",
            "items": { "$ref": "#/components/schemas/Product" },
            "example": ["ACCOUNTS", "TRANSACTIONS"]
          }
        }
      },
      "ConnectTokenRequest": {
        "type": "object",
        "description": "Corpo do connect_token. Todos os campos são opcionais; `{}` cria um token para um novo item.",
        "properties": {
          "itemId": {
            "type": "string",
            "format": "uuid",
            "description": "Informe apenas para colocar o widget em modo de atualização de um item existente (re-auth / MFA / renovação de consentimento). Omita para criar um novo item.",
            "example": "a8f4f3e1-7b2c-4d4e-8f9a-0b1c2d3e4f5a"
          },
          "options": { "$ref": "#/components/schemas/ConnectTokenOptions" }
        }
      },
      "ConnectTokenResponse": {
        "type": "object",
        "description": "Token com escopo do Connect Widget.",
        "required": ["accessToken"],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Token com TTL de 30 minutos para dirigir o Connect Widget e ler o único item que ele cria/atualiza.",
            "example": "<CONNECT_TOKEN>"
          }
        }
      },
      "CredentialDescriptor": {
        "type": "object",
        "description": "Descritor de uma entrada que o usuário deve preencher no widget. Pode representar credencial não bancária, como CPF/CNPJ, ou uma seleção de jornada; senhas bancárias permanecem na interface hospedada de autorização.",
        "required": ["label", "name", "type", "optional"],
        "properties": {
          "label": {
            "type": "string",
            "description": "Rótulo humano renderizado pelo widget.",
            "example": "Senha"
          },
          "name": {
            "type": "string",
            "description": "Chave usada dentro de `parameters` no POST /items (ex.: cpf, password, agency, account, token).",
            "example": "password"
          },
          "type": {
            "type": "string",
            "description": "Tipo do campo de entrada.",
            "enum": ["text", "password", "number", "image", "select", "ethaddress", "hcaptcha"],
            "example": "password"
          },
          "placeholder": {
            "type": ["string", "null"],
            "description": "Placeholder do campo.",
            "example": "Sua senha do internet banking"
          },
          "validation": {
            "type": ["string", "null"],
            "description": "Regex de validação client-side; o servidor também valida (400 com errors[] em caso de falha).",
            "example": "^.{6,}$"
          },
          "validationMessage": {
            "type": ["string", "null"],
            "description": "Mensagem exibida quando a validação falha.",
            "example": "Mínimo de 6 caracteres"
          },
          "optional": {
            "type": "boolean",
            "description": "`false` = obrigatório.",
            "example": false
          },
          "assistiveText": {
            "type": ["string", "null"],
            "description": "Texto de ajuda abaixo do campo.",
            "example": "A mesma senha usada no app do banco"
          },
          "options": {
            "type": ["array", "null"],
            "description": "Para `type: select`: lista de opções { label, value }.",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "value": { "type": "string" }
              }
            },
            "example": null
          },
          "mfa": {
            "type": ["boolean", "null"],
            "description": "`true` marca o campo como campo de MFA/token (MFA de etapa única inclui no formulário inicial).",
            "example": false
          }
        },
        "example": {
          "label": "Senha",
          "name": "password",
          "type": "password",
          "placeholder": "Sua senha do internet banking",
          "validation": "^.{6,}$",
          "validationMessage": "Mínimo de 6 caracteres",
          "optional": false,
          "assistiveText": "A mesma senha usada no app do banco",
          "options": null,
          "mfa": false
        }
      },
      "ConnectorHealth": {
        "type": "object",
        "description": "Saúde operacional do conector.",
        "required": ["status", "stage"],
        "properties": {
          "status": {
            "type": "string",
            "description": "Saúde operacional atual do conector.",
            "enum": ["ONLINE", "OFFLINE", "UNSTABLE"],
            "example": "ONLINE"
          },
          "stage": {
            "type": ["string", "null"],
            "description": "`BETA` marca conectores em beta; `null` caso contrário.",
            "enum": ["BETA", null],
            "example": null
          }
        },
        "example": { "status": "ONLINE", "stage": null }
      },
      "Connector": {
        "type": "object",
        "description": "Integração com uma instituição financeira específica. Declara credenciais necessárias, produtos suportados e saúde.",
        "required": [
          "id",
          "name",
          "institutionUrl",
          "imageUrl",
          "primaryColor",
          "country",
          "type",
          "credentials",
          "products",
          "isOpenFinance",
          "isSandbox",
          "oauth",
          "oauthUrl",
          "hasMFA",
          "supportsPaymentInitiation",
          "health",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Id estável para este conector. Trate como opaco e descubra em GET /connectors; somente 0–99 é reservado aos conectores de sandbox.",
            "example": 612
          },
          "name": {
            "type": "string",
            "description": "Nome de exibição da instituição.",
            "example": "Nubank"
          },
          "institutionUrl": {
            "type": "string",
            "format": "uri",
            "description": "Site da instituição.",
            "example": "https://nubank.com.br"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "Logo (SVG/PNG) servido via CDN.",
            "example": "https://malvo.io/connectors/nubank.svg"
          },
          "primaryColor": {
            "type": "string",
            "description": "Cor hexadecimal SEM prefixo `#`.",
            "example": "820AD1"
          },
          "country": {
            "type": "string",
            "description": "ISO-3166-1 alpha-2.",
            "example": "BR"
          },
          "type": {
            "type": "string",
            "description": "Tipo do conector.",
            "enum": ["PERSONAL_BANK", "BUSINESS_BANK", "INVESTMENT", "OTHER"],
            "example": "PERSONAL_BANK"
          },
          "credentials": {
            "type": "array",
            "description": "Descritores de entrada antes do redirect. No Brasil normalmente CPF/CNPJ; no fluxo internacional geralmente é [], mas pode conter o select authMethod quando uma jornada precisa ou pode ser selecionada via API. Nunca contém senha bancária.",
            "items": { "$ref": "#/components/schemas/CredentialDescriptor" }
          },
          "products": {
            "type": "array",
            "description": "Produtos anunciados por este conector. O Open Banking internacional anuncia ACCOUNTS e TRANSACTIONS.",
            "items": { "$ref": "#/components/schemas/Product" },
            "example": ["ACCOUNTS", "CREDIT_CARDS", "TRANSACTIONS", "INVESTMENTS", "IDENTITY"]
          },
          "isOpenFinance": {
            "type": "boolean",
            "description": "`true` = conector regulado de Open Finance Brasil ou Open Banking/AIS.",
            "example": true
          },
          "isSandbox": {
            "type": "boolean",
            "description": "`true` = conector de teste do ambiente sandbox.",
            "example": false
          },
          "oauth": {
            "type": "boolean",
            "description": "`true` = conexão exige redirect OAuth para a instituição.",
            "example": true
          },
          "oauthUrl": {
            "type": ["string", "null"],
            "description": "URL efêmera de autorização no contexto de criação/reconsentimento do Item; normalmente null no catálogo.",
            "example": null
          },
          "hasMFA": {
            "type": "boolean",
            "description": "`true` = conector pode emitir um desafio de MFA (conectores diretos).",
            "example": false
          },
          "supportsPaymentInitiation": {
            "type": "boolean",
            "description": "Sempre `false` na Malvo (mantido por compatibilidade de wire).",
            "const": false,
            "example": false
          },
          "health": { "$ref": "#/components/schemas/ConnectorHealth" },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp ISO-8601 de criação do registro do conector.",
            "example": "2024-06-01T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp ISO-8601 da última atualização do registro do conector.",
            "example": "2025-01-01T00:00:00.000Z"
          }
        },
        "example": {
          "id": 612,
          "name": "Nubank",
          "institutionUrl": "https://nubank.com.br",
          "imageUrl": "https://malvo.io/connectors/nubank.svg",
          "primaryColor": "820AD1",
          "country": "BR",
          "type": "PERSONAL_BANK",
          "credentials": [
            {
              "label": "CPF",
              "name": "cpf",
              "type": "number",
              "placeholder": "999.999.999-99",
              "validation": "^\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}$",
              "validationMessage": "CPF deve ter 11 dígitos",
              "optional": false
            }
          ],
          "products": ["ACCOUNTS", "CREDIT_CARDS", "TRANSACTIONS", "INVESTMENTS", "IDENTITY"],
          "isOpenFinance": true,
          "isSandbox": false,
          "oauth": true,
          "oauthUrl": null,
          "hasMFA": false,
          "supportsPaymentInitiation": false,
          "health": { "status": "ONLINE", "stage": null },
          "createdAt": "2024-06-01T00:00:00.000Z",
          "updatedAt": "2025-01-01T00:00:00.000Z"
        }
      },
      "Consent": {
        "type": "object",
        "description": "Consentimento normalizado de Open Finance/Open Banking. Registra status, produtos, permissões e validade.",
        "required": [
          "id",
          "itemId",
          "status",
          "products",
          "openFinancePermissionsGranted",
          "createdAt",
          "updatedAt",
          "expiresAt",
          "revokedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Id do consentimento.",
            "example": "c1d2e3f4-0000-4abc-9def-111213141516"
          },
          "itemId": {
            "type": "string",
            "format": "uuid",
            "description": "Item dono do consentimento.",
            "example": "a8f4f3e1-7b2c-4d4e-8f9a-0b1c2d3e4f5a"
          },
          "status": {
            "type": "string",
            "description": "Estado normalizado do consentimento.",
            "enum": ["AWAITING_AUTHORISATION", "AUTHORISED", "CONSUMED", "REJECTED", "REVOKED", "EXPIRED"],
            "example": "AUTHORISED"
          },
          "products": {
            "type": "array",
            "description": "Produtos cobertos pelo consentimento.",
            "items": { "$ref": "#/components/schemas/Product" },
            "example": ["ACCOUNTS", "TRANSACTIONS", "INVESTMENTS"]
          },
          "openFinancePermissionsGranted": {
            "type": "array",
            "description": "Permissões normalizadas; nomes variam por modalidade (ex.: ACCOUNTS_READ/RESOURCES_READ no Brasil ou ACCOUNTS/BALANCES/TRANSACTIONS no fluxo internacional).",
            "items": { "type": "string" },
            "example": ["ACCOUNTS_READ", "ACCOUNTS_BALANCES_READ", "RESOURCES_READ"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp ISO-8601 de criação do consentimento.",
            "example": "2025-01-01T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp ISO-8601 da última mudança conhecida.",
            "example": "2025-01-01T00:05:00.000Z"
          },
          "expiresAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Expiração quando conhecida; no fluxo internacional é limitada pela validade máxima informada pelo ASPSP.",
            "example": null
          },
          "revokedAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Definido quando revogado; `null` caso contrário.",
            "example": null
          }
        },
        "example": {
          "id": "c1d2e3f4-0000-4abc-9def-111213141516",
          "itemId": "a8f4f3e1-7b2c-4d4e-8f9a-0b1c2d3e4f5a",
          "status": "AUTHORISED",
          "products": ["ACCOUNTS", "TRANSACTIONS"],
          "openFinancePermissionsGranted": ["ACCOUNTS", "BALANCES", "TRANSACTIONS"],
          "createdAt": "2025-01-01T00:00:00.000Z",
          "updatedAt": "2025-01-01T00:05:00.000Z",
          "expiresAt": null,
          "revokedAt": null
        }
      },
      "PaginationEnvelope": {
        "type": "object",
        "description": "Envelope de paginação comum a todos os endpoints de listagem.",
        "required": ["total", "totalPages", "page", "results"],
        "properties": {
          "total": {
            "type": "integer",
            "description": "Total de registros que casam com o filtro.",
            "example": 1
          },
          "totalPages": {
            "type": "integer",
            "description": "ceil(total/pageSize).",
            "example": 1
          },
          "page": {
            "type": "integer",
            "description": "Página atual (base 1).",
            "example": 1
          },
          "results": {
            "type": "array",
            "description": "Itens da página.",
            "items": {}
          }
        }
      },
      "ConnectorsPage": {
        "allOf": [
          { "$ref": "#/components/schemas/PaginationEnvelope" },
          {
            "type": "object",
            "properties": {
              "results": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Connector" }
              }
            }
          }
        ],
        "description": "Envelope paginado de conectores."
      },
      "ConsentsPage": {
        "allOf": [
          { "$ref": "#/components/schemas/PaginationEnvelope" },
          {
            "type": "object",
            "properties": {
              "results": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Consent" }
              }
            }
          }
        ],
        "description": "Envelope paginado de consentimentos."
      },
      "GlobalErrorResponse": {
        "type": "object",
        "description": "Envelope de erro usado por toda resposta não-2xx da API.",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "integer",
            "description": "Espelha o código HTTP.",
            "example": 429
          },
          "message": {
            "type": "string",
            "description": "Descrição humana. NÃO é estável — nunca faça parsing.",
            "example": "Too many requests. Please try again later (see Retry-After header in seconds)"
          },
          "codeDescription": {
            "type": "string",
            "description": "Discriminador estável e legível por máquina (SCREAMING_SNAKE_CASE). Clientes ramificam por este valor.",
            "example": "TOO_MANY_REQUESTS"
          },
          "data": {
            "type": "object",
            "description": "Contexto adicional livre.",
            "example": {}
          }
        },
        "example": {
          "code": 429,
          "message": "Too many requests. Please try again later (see Retry-After header in seconds)",
          "codeDescription": "TOO_MANY_REQUESTS",
          "data": {}
        }
      }
    }
  }
}
